---
import Base from '../layouts/Base.astro'
---

<Base
  title="Page not found — Switch Karle"
  description="That page does not exist. All Switch Karle tools run in your browser — nothing is uploaded."
>
  <main class="mx-auto max-w-2xl px-4 py-16 text-center">
    <p class="text-6xl font-extrabold tracking-tight">404</p>
    <h1 class="mt-3 text-xl font-bold">Page not found</h1>
    <p class="mx-auto mt-2 max-w-md text-[15px] leading-relaxed text-[var(--color-ink-soft, #57534e)]">
      That URL does not exist. Every tool lives one tap away on the home page — and everything still runs entirely in your browser.
    </p>
    <a
      href="/switch-karle/"
      class="mt-6 inline-block rounded-full bg-saffron px-6 py-2.5 text-sm font-bold text-white transition-transform active:scale-[0.98]"
    >
      Go to the home page
    </a>
  </main>
</Base>
