---
import { SITE } from '../../../site.config.mjs'
import Base from '../../layouts/Base.astro'
import HomeTool from '../../tools/home/index'

const title = 'Switch Karle — पूरा job switch, “बस, अब यहाँ नहीं” से day 90 तक'
const description =
  '“बस, अब यहाँ नहीं” से लेकर नई नौकरी के पहले 90 दिन तक: आपकी exit dates, offer में असल में क्या मिलेगा, notice और F&F। Free है, और पूरा आपके browser में चलता है।'
const site = (import.meta.env.SITE || SITE).replace(/\/$/, '')
const base = (import.meta.env.BASE_URL || '/').endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const url = `${site}${base}hi/`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Switch Karle',
  url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  description,
}
---

<Base title={title} description={description} jsonLd={jsonLd} lang="hi">
  <HomeTool client:load lang="hi" />
</Base>
