---
import { SITE } from '../../../site.config.mjs'
import Base from '../../layouts/Base.astro'
import HomeTool from '../../tools/home/index'

const title = 'Switch Karle: India में job बदलने के free tools'
const description =
  'India में job switch के हर step के लिए free calculators और letters: in-hand salary, notice period, gratuity, final settlement, PF और tax। Login नहीं।'
const site = (import.meta.env.SITE || SITE).replace(/\/$/, '')
const base = (import.meta.env.BASE_URL || '/').endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const url = `${site}${base}hi/`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Switch Karle',
  url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  description,
}
---

<Base title={title} description={description} jsonLd={jsonLd} lang="hi">
  <HomeTool client:load lang="hi" />
</Base>
