---
import { SITE } from '../../../site.config.mjs'
import Base from '../../layouts/Base.astro'
import HomeTool from '../../tools/home/index'

const title = 'Resign करने का सबसे safe दिन ढूँढें — Switch Karle'
const description =
  'तीन सवाल, salary नहीं पूछेंगे: gratuity safe होने की date, hike आने का महीना, और दोनों गँवाए बिना resign करने का पहला दिन। Free, आपके browser में।'
const site = (import.meta.env.SITE || SITE).replace(/\/$/, '')
const base = (import.meta.env.BASE_URL || '/').endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const url = `${site}${base}hi/`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Switch Karle',
  url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  description,
}
---

<Base title={title} description={description} jsonLd={jsonLd} lang="hi">
  <HomeTool client:load lang="hi" />
</Base>
