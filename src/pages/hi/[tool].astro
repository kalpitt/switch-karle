---
import Base from '../../layouts/Base.astro'
import { islandTools, toolBySlug } from '../../data/tools'
import ToolIslands from '../../components/ToolIslands.astro'
import { epfFaqJsonLd } from '../../data/epfFaq'

export function getStaticPaths() {
  return islandTools().map((tool) => ({ params: { tool: tool.slug } }))
}

const slug = Astro.params.tool
if (!slug) throw new Error('missing tool slug')
const def = toolBySlug(slug)
if (!def) throw new Error(`unknown tool: ${slug}`)

const epfFaq = slug === 'epf-transfer' ? epfFaqJsonLd() : undefined
---

<Base title={def.seoTitle} description={def.seoDescription} slug={slug} jsonLd={epfFaq} lang="hi">
  <ToolIslands slug={slug} lang="hi" />
</Base>
