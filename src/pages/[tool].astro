---
import Base from '../layouts/Base.astro'
import { islandTools, toolBySlug } from '../data/tools'
import DecoderTool from '../tools/decoder/index'
import TrackerTool from '../tools/tracker/index'
import PromptsTool from '../tools/prompts/index'
import OfferComparisonTool from '../tools/offer-comparison/index'
import RealHikeTool from '../tools/real-hike/index'
import VariableRealityTool from '../tools/variable-reality/index'
import BonusClawbackTool from '../tools/bonus-clawback/index'
import EsopRealityTool from '../tools/esop-reality/index'
import RelocationTool from '../tools/relocation/index'
import FakeOfferTool from '../tools/fake-offer/index'
import NoticeBuyoutTool from '../tools/notice-buyout/index'
import GratuityTool from '../tools/gratuity/index'
import LeaveEncashmentTool from '../tools/leave-encashment/index'
import FnfCheckerTool from '../tools/fnf-checker/index'
import Form16ShockTool from '../tools/form16-shock/index'
import ResignationLetterTool from '../tools/resignation-letter/index'
import ManagerScriptTool from '../tools/manager-script/index'
import HrScriptTool from '../tools/hr-script/index'
import CounterOfferTool from '../tools/counter-offer/index'
import HandoverDocTool from '../tools/handover-doc/index'
import RelievingChaserTool from '../tools/relieving-chaser/index'
import { isHrScriptSlug } from '../data/hrScripts'

export function getStaticPaths() {
  return islandTools().map((tool) => ({ params: { tool: tool.slug } }))
}

const slug = Astro.params.tool
if (!slug) throw new Error('missing tool slug')
const def = toolBySlug(slug)
if (!def) throw new Error(`unknown tool: ${slug}`)
---

<Base title={def.seoTitle} description={def.seoDescription} slug={slug}>
  {slug === 'decoder' && <DecoderTool client:load />}
  {slug === 'tracker' && <TrackerTool client:load />}
  {slug === 'prompts' && <PromptsTool client:load />}
  {slug === 'offer-comparison' && <OfferComparisonTool client:load />}
  {slug === 'real-hike' && <RealHikeTool client:load />}
  {slug === 'variable-reality' && <VariableRealityTool client:load />}
  {slug === 'bonus-clawback' && <BonusClawbackTool client:load />}
  {slug === 'esop-reality' && <EsopRealityTool client:load />}
  {slug === 'relocation' && <RelocationTool client:load />}
  {slug === 'fake-offer' && <FakeOfferTool client:load />}
  {slug === 'notice-buyout' && <NoticeBuyoutTool client:load />}
  {slug === 'gratuity' && <GratuityTool client:load />}
  {slug === 'leave-encashment' && <LeaveEncashmentTool client:load />}
  {slug === 'fnf-checker' && <FnfCheckerTool client:load />}
  {slug === 'form16-shock' && <Form16ShockTool client:load />}
  {slug === 'resignation-letter' && <ResignationLetterTool client:load />}
  {slug === 'manager-script' && <ManagerScriptTool client:load />}
  {isHrScriptSlug(slug) && <HrScriptTool client:load slug={slug} />}
  {slug === 'counter-offer' && <CounterOfferTool client:load />}
  {slug === 'handover-doc' && <HandoverDocTool client:load />}
  {slug === 'relieving-chaser' && <RelievingChaserTool client:load />}
</Base>
