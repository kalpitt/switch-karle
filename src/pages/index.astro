---
import { SITE } from '../../site.config.mjs'
import Base from '../layouts/Base.astro'
import HomeTool from '../tools/home/index'

const title = 'Find the safest day to resign — Switch Karle'
const description =
  'Three questions, no salary asked: when your gratuity is safe, when your hike lands and the first day to resign without losing either. Free, in your browser.'
const site = (import.meta.env.SITE || SITE).replace(/\/$/, '')
const base = (import.meta.env.BASE_URL || '/').endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const url = `${site}${base}`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Switch Karle',
  url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  description,
}
---

<Base title={title} description={description} jsonLd={jsonLd} lang="en">
  <HomeTool client:load lang="en" />
</Base>
