---
import Base from '../layouts/Base.astro'
import HomeTool from '../tools/home/index'

const title = 'Switch Karle — the whole job switch, from “I’m done here” to day 90'
const description =
  'From “I’m done here” to your first 90 days in the new job: your exit dates, what an offer really pays, notice and F&F. Free, and all in your browser.'
const site = (import.meta.env.SITE || 'https://kalpit.me').replace(/\/$/, '')
const base = (import.meta.env.BASE_URL || '/').endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const url = `${site}${base}`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Switch Karle',
  url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  description,
}
---

<Base title={title} description={description} jsonLd={jsonLd} lang="en">
  <HomeTool client:load lang="en" />
</Base>
