---
import { SITE } from '../../site.config.mjs'
import Base from '../layouts/Base.astro'
import HomeTool from '../tools/home/index'

const title = 'Switch Karle: free tools for changing jobs in India'
const description =
  'Free calculators and letters for every step of a job switch in India: in-hand salary, notice period, gratuity, final settlement, PF and tax. No login.'
const site = (import.meta.env.SITE || SITE).replace(/\/$/, '')
const base = (import.meta.env.BASE_URL || '/').endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const url = `${site}${base}`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Switch Karle',
  url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  description,
}
---

<Base title={title} description={description} jsonLd={jsonLd} lang="en">
  <HomeTool client:load lang="en" />
</Base>
