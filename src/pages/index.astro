---
import Base from '../layouts/Base.astro'
import HomeTool from '../tools/home/index'

const title = 'Switch Karle — Track your job switch. Decode your CTC.'
const description =
  'Track every application in your Indian job switch on one board, with 32 free tools for the money moments: CTC to real in-hand salary, notice periods, bonds, variable pay and F&F. Free, open source, 100% in your browser.'
const site = (import.meta.env.SITE || 'https://kalpit.me').replace(/\/$/, '')
const base = (import.meta.env.BASE_URL || '/').endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const url = `${site}${base}`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Switch Karle',
  url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  description,
}
---

<Base title={title} description={description} jsonLd={jsonLd} lang="en">
  <HomeTool client:load lang="en" />
</Base>
